# Public UPI payment details shown to customers (these are not secrets).
NEXT_PUBLIC_UPI_ID=dc9958211@okicici
NEXT_PUBLIC_UPI_PAYEE_NAME=NETEXTERIOR
NEXT_PUBLIC_PRO_SUPPORT_EMAIL=mc9958211@gmail.com

# Supabase project URL and server-only service_role key. Never use NEXT_PUBLIC_ here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Admin portal credentials. Set a password with at least 12 characters.
PRO_ADMIN_USERNAME=admin
PRO_ADMIN_PASSWORD=
# Generate independent random 32-byte values for session and license signing.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRO_ADMIN_SESSION_SECRET=

# Pro license signing secret. Never prefix secrets with NEXT_PUBLIC_.
PRO_LICENSE_SECRET=

# Gmail account that sends approved Pro license emails. Requires a Google App Password.
GMAIL_SMTP_USER=mc9958211@gmail.com
GMAIL_SMTP_APP_PASSWORD=

# After deployment, sign in at /admin/payments using the admin credentials above.
# Customers submit UTRs in the Pro dialog; verify each one in your bank app before approval.
