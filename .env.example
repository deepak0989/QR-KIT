# Public UPI payment details shown to customers (these are not secrets).
NEXT_PUBLIC_UPI_ID=dc9958211@okicici
NEXT_PUBLIC_UPI_PAYEE_NAME=NETEXTERIOR
NEXT_PUBLIC_PRO_SUPPORT_EMAIL=mc9958211@gmail.com

# Supabase project URL and server-only service_role key. Never use NEXT_PUBLIC_ here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Use different random values of at least 32 bytes. Never prefix these with NEXT_PUBLIC_.
# Generate each value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRO_ADMIN_TOKEN=
PRO_LICENSE_SECRET=

# After deployment, review UPI payments at /admin/payments using PRO_ADMIN_TOKEN.
# Customers submit UTRs in the Pro dialog; verify each one in your bank app before approval.
